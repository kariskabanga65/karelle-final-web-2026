# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke GitHub.

# Koneksi PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kar_class_db

# Better Auth
# Secret acak minimal 32 karakter. Buat dengan salah satu perintah:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# URL publik aplikasi (dipakai di client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
