# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local ke GitHub.

# Koneksi PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kar_class_db

# Better Auth
# Buat secret acak minimal 32 karakter, misalnya dengan: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# URL publik aplikasi (dipakai di client)
NEXT_PUBLIC_APP_URL=http://localhost:3000
